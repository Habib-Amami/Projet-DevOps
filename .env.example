# =============================================================================
# Local development configuration
#
# Copy this file to .env and adjust the passwords. This is the single source of
# truth for local backend, frontend and Docker Compose values. The cluster uses
# Kubernetes ConfigMaps/Secrets with the same variable names.
# =============================================================================

# Database
MYSQL_DATABASE=achatdb

# Admin password - generate one: openssl rand -hex 24
MYSQL_ROOT_PASSWORD=replace-with-a-random-root-password
# Application user created by the MySQL image - must NOT be "root".
# Root is only configured through MYSQL_ROOT_PASSWORD above.
DB_USERNAME=achat_user
# Use a DIFFERENT random password: openssl rand -hex 24
DB_PASSWORD=replace-with-a-random-app-password

# Host-side JDBC URL used by Maven. Compose overrides it to mysql:3306.
DB_URL=jdbc:mysql://localhost:3306/achatdb?serverTimezone=UTC&allowPublicKeyRetrieval=true&useSSL=false

# Backend
SERVER_PORT=8089
JPA_DDL_AUTO=validate
APP_SEED_ENABLED=true
SPRINGDOC_ENABLED=true
OTEL_METRICS_ENABLED=true
OTEL_TRACING_ENABLED=true
# Host-side OTLP endpoints used by Maven. Compose overrides them to grafana-lgtm.
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://localhost:4318/v1/metrics
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces

# Frontend
# Host-side target used by the Angular dev proxy. Compose overrides it to
# http://backend:8089 inside the frontend container.
BACKEND_URL=http://localhost:8089
# Docker's embedded DNS. On Kubernetes, set the cluster DNS instead.
DNS_RESOLVER=127.0.0.11

# Host ports
FRONTEND_PORT=4200
BACKEND_PORT=8089
GRAFANA_PORT=3000
