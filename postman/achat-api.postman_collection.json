        {
          "name": "Create stock",
          "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"libelleStock\":\"Postman stock\",\"qte\":25,\"qteMin\":5}"}, "url": "{{baseUrl}}/stocks"},
