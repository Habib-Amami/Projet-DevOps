          "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"codeProduit\":\"PROD-POSTMAN\",\"libelleProduit\":\"Postman product\",\"prix\":12.5,\"dateCreation\":\"2025-01-01\",\"dateDerniereModification\":\"2025-01-01\",\"stock\":{\"idStock\":{{stockId}}},\"categorieProduit\":{\"idCategorieProduit\":{{categoryId}}}}"}, "url": "{{baseUrl}}/produits"},
          "response": []
