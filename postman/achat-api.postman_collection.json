        {"name": "Revenue between dates", "request": {"method": "GET", "header": [], "url": "{{baseUrl}}/reglements/revenue?startDate=2025-01-01&endDate=2025-12-31"}, "response": []},
        {"name": "Get payment", "request": {"method": "GET", "header": [], "url": "{{baseUrl}}/reglements/{{paymentId}}"}, "response": []}
